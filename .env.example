# Core Configuration
# Telegram
BOT_TOKEN=ВАШ_ТОКЕН_БОТА_ТЕЛЕГРАМ
ADMIN_USER_ID=ВАШ_USER_ID_В_ТЕЛЕГРАМ

# Webhook
TELEGRAM_WEBHOOK_URL=https://your-domain.com/

# AI Configuration
AI_PROVIDER=openai # Options: openai, ollama

# --- OpenAI Settings (required if AI_PROVIDER=openai) ---
# Official OpenAI API
OPENAI_API_KEY=sk-... # Your OpenAI API Key
OPENAI_MODEL=gpt-3.5-turbo # Or gpt-4o, etc.
# Custom OpenAI-compatible API (e.g., proxy, local service)
# OPENAI_BASE_URL=https://your-openai-proxy.com/v1 # Uncomment and set if using custom API

# --- Ollama Settings (required if AI_PROVIDER=ollama) ---
OLLAMA_URL=http://host.docker.internal:11434 # Adjust if Ollama runs elsewhere
OLLAMA_MODEL=llama3.2 # Or any other model you have pulled

# --- AI General Settings (apply to all providers) ---
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7
# Системный промт для ИИ
AI_SYSTEM_PROMPT=You are a helpful assistant for a Telegram Business account. Answer questions politely and concisely.

# Rate Limiting
RATE_LIMIT_WINDOW=60    # Time window in seconds (e.g., 60 seconds)
RATE_LIMIT_MAX_REQUESTS=5 # Max requests per window per chat_id

# Safety & Limits
MAX_MESSAGE_LENGTH=4096 # Max length of message to send to AI (optional, implement in handlers if needed)
