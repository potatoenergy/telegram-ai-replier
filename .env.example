# --- Update Mode ---
# "webhook" - receive updates via webhook (requires public URL)
# "polling" - receive updates via long polling (works behind NAT/firewall)
UPDATE_MODE=webhook

# --- Telegram ---
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Technical admins (commands /start, /status; ignored in business chat AI processing)
ADMIN_USER_IDS=123456789,987654321
# Business owner (messages processed by AI + has admin command access)
BUSINESS_USER_ID=123456789
TELEGRAM_WEBHOOK_URL=https://your-domain.com/
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- AI Configuration ---
AI_PROVIDER=openai

# --- OpenAI Settings ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_BASE_URL=https://your-openai-proxy.com/v1

# --- Ollama Settings ---
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# --- AI General Settings ---
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7
AI_SYSTEM_PROMPT=You are a helpful assistant for a Telegram Business account.
CHAT_HISTORY_SIZE=10

# --- Proxy (applies to all outgoing requests) ---
# PROXY_URL=socks5://user:pass@host:1080

# --- Rate Limiting ---
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=5

# --- Safety & Timing ---
# Min/max delay before sending reply (ms). Bot picks random value in range.
MIN_RESPONSE_DELAY=3000
MAX_RESPONSE_DELAY=8000
# Probability of responding to a business message (0.0 - 1.0)
CHAT_RESPONSE_PROBABILITY=1.0
# Ignore users by ID (comma-separated)
IGNORE_USER_IDS=
# Ignore users by substring in username or first_name (comma-separated, case-insensitive)
IGNORE_USER_PATTERNS=BotUser,System,SpamBot
# Max AI response length (characters)
MAX_MESSAGE_LENGTH=4096

# --- Polling Settings (only for UPDATE_MODE=polling) ---
POLLING_TIMEOUT=30

# --- Debug ---
DEBUG=false